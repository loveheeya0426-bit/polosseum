# FTP 배포 설정 (SiteGround)
FTP_HOST=ftp.njoblog.net
FTP_USER=your_ftp_user
FTP_PASS=your_ftp_password
FTP_REMOTE_PATH=njoblog.net/public_html

# Google AdSense (승인 후 입력)
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 선관위 API (공공데이터포털에서 발급)
# https://www.data.go.kr/data/15000908/openapi.do
NEC_API_KEY=your_api_key_here

# 네이버 DataLab API (인지도 스탯용)
# https://developers.naver.com 에서 애플리케이션 등록 → 데이터랩 API 신청
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
